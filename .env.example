# ---------------------------------------------------------------------------
# Conexión con n8n
# ---------------------------------------------------------------------------
# Sin estas variables el panel funciona igual, pero en modo local: los cambios
# se guardan solo en el navegador y no se dispara ningún workflow.

# Raíz de la instancia, SIN barra final. En desarrollo usa /n8n para pasar por el
# proxy de Vite y evitar CORS; en producción, la URL pública de tu instancia.
#   desarrollo: VITE_N8N_BASE_URL=/n8n
#   producción: VITE_N8N_BASE_URL=https://tu-instancia.app.n8n.cloud
VITE_N8N_BASE_URL=/n8n

# Destino real del proxy de desarrollo. Solo lo lee vite.config.js; nunca llega
# al navegador. Déjalo vacío si VITE_N8N_BASE_URL ya es una URL absoluta.
N8N_PROXY_TARGET=http://localhost:5678

# Valor de la cabecera Authorization, si proteges los webhooks con Header Auth.
# Ojo: cualquier variable VITE_* acaba en el bundle y es visible para el usuario.
# Usa un token exclusivo de estos webhooks, nunca una clave de la Public API.
VITE_N8N_WEBHOOK_TOKEN=

# Ponlo a true para usar las URLs /webhook-test en lugar de /webhook. Solo
# responden mientras el workflow está abierto y a la escucha en el editor.
VITE_N8N_TEST_WEBHOOKS=false
